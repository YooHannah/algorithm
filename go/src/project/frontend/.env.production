# 生产环境默认对接真实后端
VITE_USE_MOCK=false
VITE_API_BASE_URL=

# 菜单/权限模块：后端权限接口未实现前保持 true，接口上线后改为 false
VITE_USE_PERMISSION_MOCK=true

# 飞书扫码登录（QR SDK）配置
VITE_FEISHU_APP_ID=cli_a904603e58e29bc0
# 生产回调地址，需在开放平台登记，例如 https://your-domain.com/login/feishu/callback
VITE_FEISHU_REDIRECT_URI=https://your-domain.com/login/feishu/callback
