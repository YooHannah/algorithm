# true: 使用前端内置 Mock，无需后端即可演示登录流程
# false: 调用真实后端接口（通过 Vite proxy 转发 /api -> http://localhost:8081）
VITE_USE_MOCK=false
# 接口基础地址，留空走相对路径 + Vite 代理
VITE_API_BASE_URL=

# 菜单/权限模块单独使用 Mock（后端权限接口未实现前保持 true，就绪后置 false）
VITE_USE_PERMISSION_MOCK=false

# 管理员模块单独使用 Mock（后端 /v1/user/list 接口就绪后置 false）
VITE_USE_ADMIN_USER_MOCK=false

# 角色模块单独使用 Mock（后端 role 接口就绪后置 false）
VITE_USE_ROLE_MOCK=false

# 飞书扫码登录（QR SDK）配置
# 飞书自建应用的 App ID，开放平台「凭证与基础信息」中获取
VITE_FEISHU_APP_ID=cli_a904603e58e29bc0
# 在开放平台「安全设置-重定向 URL」中登记的回调地址（需与平台登记完全一致）
# 开发示例：http://localhost:5173/login/feishu/callback
VITE_FEISHU_REDIRECT_URI=http://localhost:5173/login/feishu/callback
